# Application
NODE_ENV=development
PORT=3000
APP_NAME=medi-waste-management-backend

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=medi_waste_management
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Bind address: 0.0.0.0 so phones/other PCs on the LAN can reach the API
HOST=0.0.0.0

# CORS
# Development: any origin is allowed (LAN demo).
# Production: set the real frontend URL, e.g. https://app.yourdomain.com
CORS_ORIGIN=*

# Folder for uploaded files such as logos (relative to the backend working directory, or an absolute path)
UPLOAD_DIR=./storage/uploads
