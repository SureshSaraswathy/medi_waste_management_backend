{
  "name": "medi-waste-management-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade NestJS backend for Medical Waste Management System",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:pm2:dev": "pm2 start ecosystem.config.js --env development",
    "start:pm2:prod": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "restart:pm2": "pm2 restart ecosystem.config.js",
    "delete:pm2": "pm2 delete ecosystem.config.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/database/data-source.ts",
    "migration:generate:master": "typeorm-ts-node-commonjs migration:generate -d src/config/database/master-data-source.ts",
    "migration:run:master": "typeorm-ts-node-commonjs migration:run -d src/config/database/master-data-source.ts",
    "migration:revert:master": "typeorm-ts-node-commonjs migration:revert -d src/config/database/master-data-source.ts",
    "migration:generate:transaction": "typeorm-ts-node-commonjs migration:generate -d src/config/database/transaction-data-source.ts",
    "migration:run:transaction": "typeorm-ts-node-commonjs migration:run -d src/config/database/transaction-data-source.ts",
    "migration:revert:transaction": "typeorm-ts-node-commonjs migration:revert -d src/config/database/transaction-data-source.ts",
    "migration:generate:report": "typeorm-ts-node-commonjs migration:generate -d src/config/database/report-data-source.ts",
    "migration:run:report": "typeorm-ts-node-commonjs migration:run -d src/config/database/report-data-source.ts",
    "migration:revert:report": "typeorm-ts-node-commonjs migration:revert -d src/config/database/report-data-source.ts",
    "migration:run:sql": "node scripts/run-migration.js",
    "db:create": "node scripts/create-database.js",
    "test:get-company-id": "node scripts/get-company-id.js",
    "get:company-ids": "node scripts/get-company-id.js",
    "db:create-master-tables": "node scripts/create-master-tables.js",
    "db:create-transaction-tables": "node scripts/create-transaction-tables.js",
    "db:create-test-company": "node scripts/create-test-company.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^7.0.5",
    "@types/xlsx": "^0.0.35",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.69.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.1",
    "html2pdf.js": "^0.14.0",
    "ioredis": "^5.9.3",
    "nodemailer": "^7.0.12",
    "p-limit": "^7.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "puppeteer": "^24.37.3",
    "qrcode": "^1.5.4",
    "recharts": "^2.15.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/archiver": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
