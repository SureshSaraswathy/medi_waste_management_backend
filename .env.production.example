# Production environment template. Copy to the server as `.env` (never commit the real file) and fill in the values.
# The real `.env` / `.env.production` are git-ignored; this example is safe to commit because it holds no secrets.

# ---------------------------------------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_NAME=medi-waste-management-backend
HOST=0.0.0.0

# ---------------------------------------------------------------------------------------------------------------------
# Database schema synchronization - MUST stay "false" in production
#
# TypeORM "synchronize" alters AND DROPS tables/columns to match the entity classes. It must never run against real data.
# The application only honours these flags when NODE_ENV is exactly "development" AND the flag is exactly "true", so in
# production they are ignored anyway; they are written out here (and in ecosystem.config.js) on purpose so nobody has to
# wonder. The API process and the worker process (dist/worker.js) read the same four flags and apply the same rule.
# Schema changes go through reviewed SQL migrations (migrations/*.sql) that are run deliberately.
# ---------------------------------------------------------------------------------------------------------------------
MASTER_DB_SYNCHRONIZE=false
TRANSACTION_DB_SYNCHRONIZE=false
REPORT_DB_SYNCHRONIZE=false
DB_SYNCHRONIZE=false

# ---------------------------------------------------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------------------------------------------------
MASTER_DB_HOST=
MASTER_DB_PORT=5432
MASTER_DB_USERNAME=
MASTER_DB_PASSWORD=
MASTER_DB_DATABASE=medi_waste_management_master
MASTER_DB_LOGGING=false

TRANSACTION_DB_HOST=
TRANSACTION_DB_PORT=5432
TRANSACTION_DB_USERNAME=
TRANSACTION_DB_PASSWORD=
TRANSACTION_DB_DATABASE=medi_waste_management_transaction
TRANSACTION_DB_LOGGING=false

REPORT_DB_HOST=
REPORT_DB_PORT=5432
REPORT_DB_USERNAME=
REPORT_DB_PASSWORD=
REPORT_DB_DATABASE=medi_waste_management_report
REPORT_DB_LOGGING=false

# Legacy single-database settings (kept for compatibility)
DB_TYPE=postgres
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=medi_waste_management
DB_LOGGING=false

# ---------------------------------------------------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------------------------------------------------
# Generate a long random value, e.g. `openssl rand -hex 48`. Never reuse the development value.
JWT_SECRET=
# Token lifetime (there is no refresh token): e.g. 8h, 24h
JWT_EXPIRES_IN=24h

# Real frontend origin(s), comma separated. Do NOT use * in production.
CORS_ORIGIN=https://app.example.com

# ---------------------------------------------------------------------------------------------------------------------
# Uploaded files (company logos, application logo)
# ---------------------------------------------------------------------------------------------------------------------
# Absolute path outside the code folder, owned by the account that runs the backend (mode 750), backed up with the databases.
UPLOAD_DIR=/var/lib/medi-waste/uploads
